# Server
PORT=8080
PUBLIC_URL=http://localhost:8080

# Database (required)
DATABASE_URL=postgresql://template:password@localhost:5433/template-dev

# Authentication (required)
JWT_SECRET=
ADMIN_PASSWORD=

# No-auth mode (set to true for local development without JWT)
# NO_AUTH=true

# Cache
# CACHE_ENABLED=true
# CACHE_L1_MAX_SIZE=128mb
# CACHE_L2_REDIS_URL=redis://localhost:6380
# CACHE_BUS_HOST=localhost
# CACHE_BUS_PORT=6380

# OAuth (for MCP clients)
# MCP_ACCESS_TOKEN_EXPIRY_DAYS=30

# Metrics
# METRICS_ENABLED=true

# Graceful shutdown
# GRACEFUL_SHUTDOWN_TIMEOUT=10000
